[
  {
    "id": "retroarch", "name": "RetroArch",
    "packages": ["com.retroarch.aarch64", "com.retroarch", "com.retroarch.ra32"],
    "platforms": ["nes", "snes", "n64", "gb", "gbc", "gba", "nds", "psx", "psp", "genesis", "segacd", "32x", "sms", "gamegear", "saturn", "dreamcast", "pce", "ngp", "atari2600", "arcade"],
    "activity": "com.retroarch.browser.retroactivity.RetroActivityFuture",
    "action": "android.intent.action.MAIN",
    "extras": {
      "ROM": "{rom_path}",
      "LIBRETRO": "/data/data/{package}/cores/{core}_libretro_android.so",
      "CONFIGFILE": "/storage/emulated/0/Android/data/{package}/files/retroarch.cfg",
      "QUITFOCUS": ""
    },
    "flags": ["clear_task", "clear_top", "no_history"],
    "needsFilePath": true,
    "note": "Needs RetroArch's own 'All files access' and the core for each system downloaded inside RetroArch."
  },
  {
    "id": "dolphin", "name": "Dolphin",
    "packages": ["org.dolphinemu.dolphinemu", "org.dolphinemu.mmjr", "org.mm.jr"],
    "platforms": ["gc", "wii"],
    "activity": "org.dolphinemu.dolphinemu.ui.main.MainActivity",
    "action": "android.intent.action.VIEW",
    "extras": { "AutoStartFile": "{rom_uri}" },
    "flags": ["clear_task", "clear_top"]
  },
  {
